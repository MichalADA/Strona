# Konfiguracja lokalna — skopiuj do .env i ustaw własne wartości:
#   cp .env.example .env
# Plik .env NIE trafia do repozytorium (patrz .gitignore).

# Port, na którym WordPress będzie dostępny na hoście.
WORDPRESS_PORT=8080

# Baza danych. Na produkcji ustaw długie, losowe hasła, np. `openssl rand -base64 24`.
DB_NAME=parafia
DB_USER=parafia
DB_PASSWORD=zmien_to_haslo
DB_ROOT_PASSWORD=zmien_to_haslo_roota

# Prefiks tabel — inny niż domyślny wp_ utrudnia zautomatyzowane ataki.
DB_TABLE_PREFIX=par_

# Debug: 1 tylko lokalnie, na demo/produkcji 0.
WP_DEBUG=0
